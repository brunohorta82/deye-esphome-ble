# Copy to secrets.yaml and fill in your own values. Never commit secrets.yaml.
wifi_ssid: 'your-wifi-ssid'
wifi_password: 'your-wifi-password'
# 32-byte base64 key, e.g.: python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
api_encryption_key: 'REPLACE_WITH_BASE64_KEY='
ota_password: 'choose-an-ota-password'
fallback_ap_password: 'choose-a-fallback-ap-password'
